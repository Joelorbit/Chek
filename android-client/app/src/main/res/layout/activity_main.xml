<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/eyu_canvas_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- Top Header & Brand -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🧾 Chek"
                android:textColor="@color/eyu_ink_dark"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Theme Toggle Chip -->
            <Button
                android:id="@+id/btnThemeToggle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="☀️ Light"
                android:textSize="11sp"
                android:textColor="@color/eyu_ink_dark"
                android:backgroundTint="@color/eyu_surface_elevated_dark" />
        </LinearLayout>

        <!-- Main Card Container -->
        <LinearLayout
            android:id="@+id/mainCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/eyu_surface_dark"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DEVICE PAIRING"
                android:textColor="@color/eyu_golden_ochre"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvCardSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Connect to your Chek Console"
                android:textColor="@color/eyu_ink_muted_dark"
                android:textSize="12sp"
                android:layout_marginBottom="16dp" />

            <!-- Server URL -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Server URL"
                android:textColor="@color/eyu_ink_muted_dark"
                android:textSize="11sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etServerUrl"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:hint="https://your-domain.com"
                android:textColor="@color/eyu_ink_dark"
                android:textColorHint="#55848580"
                android:background="@color/eyu_surface_pressed_dark"
                android:padding="10dp"
                android:textSize="13sp"
                android:layout_marginBottom="14dp" />

            <!-- Pairing PIN -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6-Digit Pairing PIN"
                android:textColor="@color/eyu_ink_muted_dark"
                android:textSize="11sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etPairingCode"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="1 2 3 4 5 6"
                android:textColor="@color/eyu_golden_ochre"
                android:textColorHint="#55848580"
                android:background="@color/eyu_surface_pressed_dark"
                android:padding="10dp"
                android:textSize="20sp"
                android:textStyle="bold"
                android:inputType="number"
                android:gravity="center"
                android:letterSpacing="0.2"
                android:layout_marginBottom="18dp" />

            <!-- Pair Button -->
            <Button
                android:id="@+id/btnPair"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Pair &amp; Activate Relay"
                android:textColor="@color/eyu_ink_dark"
                android:backgroundTint="@color/eyu_olive_moss"
                android:textStyle="bold"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Status Card -->
        <LinearLayout
            android:id="@+id/statusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/eyu_surface_dark"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RELAY STATUS"
                android:textColor="@color/eyu_golden_ochre"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● Ready to pair"
                android:textColor="@color/eyu_olive_moss"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvPrivacyNotice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔒 On-Device Privacy: Only payment notifications (CBE, Telebirr, Awash) are processed. OTPs and private messages are discarded locally."
                android:textColor="@color/eyu_ink_muted_dark"
                android:textSize="10sp"
                android:lineSpacingExtra="2dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
