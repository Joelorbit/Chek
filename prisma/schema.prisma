generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  password      String
  name          String?
  apiKey        String         @unique @default(cuid())
  webhookUrl    String?
  webhookSecret String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  devices       Device[]
  transactions  Transaction[]
  webhookLogs   WebhookLog[]
  checkouts     CheckoutSession[]
  channels      PaymentChannel[]
}

model PaymentChannel {
  id            String    @id @default(cuid())
  userId        String
  provider      String    // TELEBIRR, CBE, AWASH, BOA, CBE_BIRR
  accountNumber String
  accountName   String
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Device {
  id            String    @id @default(cuid())
  userId        String
  deviceName    String    @default("Android Phone")
  deviceToken   String    @unique @default(cuid())
  pairingCode   String?
  codeExpiresAt DateTime?
  batteryLevel  Int       @default(100)
  isOnline      Boolean   @default(false)
  lastPingAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id            String    @id @default(cuid())
  userId        String
  provider      String    // TELEBIRR, CBE, AWASH, BOA, CBE_BIRR
  amount        Float
  currency      String    @default("ETB")
  payerName     String
  payerPhone    String?
  referenceId   String    @unique
  balanceAfter  Float?
  rawMessage    String?
  status        String    @default("VERIFIED") // VERIFIED, PENDING, DUPLICATE
  checkoutId    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CheckoutSession {
  id            String    @id @default(cuid())
  userId        String
  title         String
  amount        Float
  currency      String    @default("ETB")
  status        String    @default("PENDING") // PENDING, PAID, EXPIRED
  customerName  String?
  customerPhone String?
  referenceId   String?
  metadata      String?   // JSON metadata
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WebhookLog {
  id            String    @id @default(cuid())
  userId        String
  transactionId String?
  endpoint      String
  event         String
  payload       String
  responseCode  Int?
  responseBody  String?
  success       Boolean   @default(false)
  createdAt     DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
